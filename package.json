{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@stuffbucket/woodchipper",
  "version": "1.0.0",
  "description": "Reverse-engineering Pi agent harness, skill pack, playbooks, workflows, and vendored REA/REAP/Pi library optimized for 5.5-series models.",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "license": "Apache-2.0",
  "author": "stuffbucket",
  "repository": {
    "type": "git",
    "url": "https://github.com/stuffbucket/woodchipper"
  },
  "bin": {
    "woodchipper": "./bin/woodchipper.mjs",
    "woodchipper-ctl": "./scripts/woodchipper-ctl.mjs"
  },
  "keywords": [
    "reverse-engineering",
    "rea",
    "rea-agents",
    "reap",
    "pi",
    "pi-coding-agent",
    "a2a",
    "agent-skills",
    "workflows",
    "mcp"
  ],
  "files": [
    "bin/",
    "skills/",
    "playbooks/",
    ".claude/workflows/",
    ".claude-plugin/",
    ".pi/",
    "mise.toml",
    "vendor/",
    "scripts/",
    "CLAUDE.md",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "rea-agents": "6.7.0"
  },
  "scripts": {
    "setup": "git submodule update --init --recursive && node scripts/build-vendor-overrides.mjs && pnpm install --frozen-lockfile && pnpm run build:harness -- --with-submodule-build",
    "build:overrides": "node scripts/build-vendor-overrides.mjs",
    "build:pi": "node scripts/build-pi-overlay.mjs",
    "site": "pnpm --filter @stuffbucket/woodchipper-site dev",
    "site:build": "pnpm --filter @stuffbucket/woodchipper-site build",
    "site:preview": "pnpm --filter @stuffbucket/woodchipper-site preview",
    "woodchipper": "node --experimental-strip-types bin/woodchipper.mjs",
    "daemon": "node --experimental-strip-types bin/woodchipper.mjs daemon",
    "ctl": "node --experimental-strip-types scripts/woodchipper-ctl.mjs",
    "build:harness": "node --experimental-strip-types scripts/build-harness.mjs",
    "rea": "rea",
    "doctor": "GHIDRA_INSTALL_DIR=${GHIDRA_INSTALL_DIR:-$HOME/.local/share/ghidra/ghidra_12.1.4_PUBLIC} JAVA_HOME=${JAVA_HOME:-$HOME/.local/share/mise/installs/java/temurin-21.0.12+101.0.LTS} rea doctor --provider ghidra --skill --json",
    "test": "node --experimental-strip-types --test tests/validate-woodchipper.test.mjs tests/pi-extension.test.mjs tests/peer-extension.test.mjs",
    "test:mutate": "node --experimental-strip-types scripts/mutation-test.mjs",
    "validate": "node scripts/validate.mjs",
    "sync:skills": "node scripts/sync-to-stuffbucket-skills.mjs",
    "update:vendor": "node scripts/update-vendor.mjs"
  }
}
